rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid in ['rrl3eojMMthlp6P6PjQDFIWo9Qg2', 'O2ttkJj8VlNLT26Z5OhTRwL8nqK2']
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'student');

      // Per-user sync subcollections written by useFirestoreSync / firestoreNotes
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
      match /journalEntries/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /appState/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Scripture Quest: per-user game history (last 6) and earned badges
      match /gameHistory/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /badges/{badgeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Scripture Quest: banco de preguntas aprobadas (lectura pública para
    // jugadores autenticados; escritura solo de administradores)
    match /scripturequest_questions/{questionId} {
      allow read: if isAuthenticated() && (resource.data.status == 'approved' || isAdmin());
      allow write: if isAdmin();
    }

    // Scripture Quest: realtime game rooms (doc id = 6-char session code)
    match /scripturequest_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      // Game flow (status, questions, timer) is driven by the host
      allow update: if isAuthenticated() && resource.data.hostId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      match /players/{playerId} {
        allow read: if isAuthenticated();
        // A player manages their own doc; the host writes scores/streaks on reveal
        allow write: if isAuthenticated() && (
          request.auth.uid == playerId ||
          request.auth.uid == get(/databases/$(database)/documents/scripturequest_rooms/$(roomId)).data.hostId
        );
      }

      match /teams/{teamId} {
        // Members vote and join in realtime; the host awards team scores
        allow read, write: if isAuthenticated();
      }
    }

    // Scripture Quest: monthly score totals (for the "campeón" badge)
    match /scripturequest_monthly/{monthId} {
      allow read, write: if isAuthenticated();
    }

    // Scripture Quest: playlists de audio por etapa (lectura jugadores, escritura admin)
    match /scripturequest_audio/{stageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /user_progress/{userId}/topics/{topicId} {
      allow read, write: if isOwner(userId);
    }

    match /user_notes/{userId}/notes/{noteId} {
      allow read, write: if isOwner(userId);
    }

    match /user_favorites/{userId}/verses/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_highlights/{userId}/items/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_margin_notes/{userId}/items/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_journal/{userId}/entries/{id} {
      allow read, write: if isOwner(userId);
    }

    // Admin collectionGroup reads for analytics dashboard
    match /{path=**}/topics/{topicId} {
      allow read: if isAdmin();
    }

    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }

    match /{path=**}/notes/{noteId} {
      allow read: if isAdmin();
    }

    match /community_messages/{messageId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /admin_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bitácora-Planner: planeación/registro personal del admin (un solo usuario)
    match /bitacora_days/{dateId} {
      allow read, write: if isAdmin();
    }
    match /bitacora_tasks/{taskId} {
      allow read, write: if isAdmin();
    }
    match /bitacora_ideas/{ideaId} {
      allow read, write: if isAdmin();
    }

    // Seeker Gospel Music System: personajes (datos internos, nunca expuestos directamente al público)
    match /characters/{characterId} {
      allow read, write: if isAdmin();
    }

    // Seeker Gospel Music System: tracks — lectura pública solo si ya está publicado
    match /tracks/{trackId} {
      allow read: if (resource.data.status == 'PUBLISHED') || isAdmin();
      allow write: if isAdmin();
    }

    // Módulo de música (álbumes + canciones de YouTube): lectura pública,
    // escritura solo admin. Colecciones propias, independientes de
    // characters/tracks (esas son del pipeline de IA de arriba).
    match /discographyAlbums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /discographyTracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Podcast/audio por lección (archivo subido o URL de YouTube):
    // lectura para usuarios autenticados, escritura solo admin.
    match /lessonAudio/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Imágenes de personajes/temas (hero, ícono, patrón, conclusión) y de
    // lecciones individuales, subidas desde el panel de Admin. Identidad
    // visual básica del catálogo: lectura pública (incluye invitados sin
    // sesión), escritura solo admin — mismo criterio que discographyAlbums.
    match /moduleMedia/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lessonMedia/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Descargables: recursos públicos (PDFs, guías, etc.) subidos por el admin.
    // Lectura pública para maximizar lo fácil de compartir; el cliente público
    // solo puede incrementar downloadCount en 1 al registrar una descarga.
    match /downloadableResources/{resourceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'updatedAt']) &&
        request.resource.data.downloadCount == resource.data.downloadCount + 1
      );
    }

    // Eventos de descarga (analítica de Descargables): solo-creación desde el
    // cliente público, sin lectura (evita exponer patrones de uso), tamaño y
    // forma acotados para mitigar spam. Solo el admin puede leerlos.
    match /downloadEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['resourceId','resourceTitle','tags','countryCode','localeRegion','timeZone','createdAt']) &&
        request.resource.data.resourceId is string && request.resource.data.resourceId.size() > 0 &&
        request.resource.data.resourceId.size() < 200 &&
        request.resource.data.resourceTitle is string && request.resource.data.resourceTitle.size() < 300 &&
        request.resource.data.tags is list && request.resource.data.tags.size() < 20 &&
        (request.resource.data.countryCode == null ||
          (request.resource.data.countryCode is string && request.resource.data.countryCode.size() == 2)) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
