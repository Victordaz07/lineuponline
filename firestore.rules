rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Prevent clients from writing role values other than 'student'
      allow write: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'student');
    }

    match /topics/{topicId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /user_progress/{userId}/topics/{topicId} {
      allow read, write: if isOwner(userId);
    }

    match /user_notes/{userId}/notes/{noteId} {
      allow read, write: if isOwner(userId);
    }

    // Datos de personalización (resaltados, notas, favoritos, diario)
    match /user_favorites/{userId}/verses/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_highlights/{userId}/items/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_margin_notes/{userId}/items/{id} {
      allow read, write: if isOwner(userId);
    }

    match /user_journal/{userId}/entries/{id} {
      allow read, write: if isOwner(userId);
    }
  }
}
